{
  "name": "@substrata/search",
  "version": "0.1.0",
  "description": "SQLite FTS5 search index for Substrata footprints and memory",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ykdhan/substrata.git",
    "directory": "packages/search"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "search",
    "sqlite",
    "fts5"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@substrata/core": "workspace:*",
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0"
  }
}
