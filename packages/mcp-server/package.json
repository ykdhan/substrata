{
  "name": "@substrata/mcp-server",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server exposing Substrata shared agent memory as tools",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ykdhan/substrata.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "mcp",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@substrata/core": "workspace:*",
    "@substrata/index": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
