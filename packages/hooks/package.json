{
  "name": "@substrata/hooks",
  "version": "0.3.0",
  "private": true,
  "description": "Claude Code lifecycle hook primitives for Substrata: the stdin/stdout protocol adapter and the .claude/settings.json installer",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
