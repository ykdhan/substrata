      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ykdhan/substrata.git",
    "directory": "packages/hooks"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "claude-code",
    "hooks"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@substrata/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
