{
  "name": "substrata-cli",
  "version": "0.2.0",
  "description": "Substrata CLI — shared project memory for AI engineering agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "substrata": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ykdhan/substrata.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "cli",
    "claude-code",
    "mcp"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.0.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@substrata/core": "workspace:*",
    "@substrata/mcp-server": "workspace:*",
    "@substrata/search": "workspace:*",
    "@types/node": "^22.0.0"
  }
}
